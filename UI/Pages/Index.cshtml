@page
@using Microsoft.AspNetCore.Authorization
@inject IAuthorizationService AuthorizationService
@model IndexModel
@{
    ViewData["Title"] = "Home page";
}

<div class="text-center">
    <h2 class="display-5">OIDC web client, confidential client using client assertions</h2>

    @if (Model.Photo.Length > 0)
    {
        <img width="200" src="data:image;base64,@System.Convert.ToBase64String(Model.Photo!)" />
    }
    else
    {
        <p>No profile photo for this user</p>
    }

    <p class="display-5">Claims for: @HttpContext.User.Identity?.Name</p>

    @if (HttpContext.User.Claims.Any())
    {
        <div class="alert alert-info">
            <h5>Security Level</h5>
            @if (HttpContext.User.Claims.Any(c => c.Type == "loa"))
            {
                <p><strong>Level of Authentication (LOA):</strong> @HttpContext.User.Claims.First(c => c.Type == "loa").Value</p>
            }
            @if (HttpContext.User.Claims.Any(c => c.Type == "loi"))
            {
                <p><strong>Level of Identification (LOI):</strong> @HttpContext.User.Claims.First(c => c.Type == "loi").Value</p>
            }
        </div>
    }

    @if (HttpContext.User.Claims.Any())
    {
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Claim Type</th>
                    <th>Claim Value</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var claim in HttpContext.User.Claims.OrderBy(c => c.Type))
                {
                    <tr>
                        <td><code>@claim.Type</code></td>
                        <td>@claim.Value</td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <p>No claims found.</p>
    }
</div>